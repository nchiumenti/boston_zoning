.         sum fam4plus_1 if only_mf == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
  5.         sum fam4plus_1 if only_mf == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"   
  6.         sum dupac if only_mf == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
  7.         sum dupac if only_mf == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                /*this is used in Table 3*/
  8.         
.         tab fam4plus_1 if e(sample), miss    /*missings are neither SF nor HD*/ 
  9.         tab fam23_1 if e(sample), miss
 10.         
.         * E: mf_du
.         quietly reg fam4plus_1 i.mf_allowed##c.dupac i.lam_seg `distance_varlist`i'' ///
>                 if mf_du == 1 & dist <= 0.2 & year_built >= 1918 & year == 2018, vce(cluster lam_seg)
 11.                 
.                 eststo E
 12.                 
.         sum fam4plus_1 if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 13.         sum fam4plus_1 if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                     
 14.         sum dupac if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 15.         sum dupac if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"          
 16.         
.         tab fam4plus_1 if e(sample), miss    /*missings are neither SF nor HD*/         
 17.         tab fam23_1 if e(sample), miss
 18.         
.         * combine results
.         esttab A  E , se r2 nobase indicate("Boundary f.e.=*lam_seg") ///
>                 label mtitles("only_mf" "mf_du") ///
>                 title("Part 7a: high density baseline after 1918 @ .20 miles (distance polynomial trends degree `i')") 
 19.         eststo clear
 20.                 
