. quietly eststo price_mfdu: reg log_saleprice ib26.dist3 i.lam_seg i.last_saleyr $char_vars if  mf_du == 1 & `regression_conditions' & ((frac_binding_mls_10_all>0.15 & frac_binding_mls_10_all!=.) | (frac_binding_maxdu_10_all>0.15 & frac_binding_maxdu_10_
> all!=.)) & frac_binding_mf>0.15 & frac_binding_mf!=., vce(cluster lam_seg)

