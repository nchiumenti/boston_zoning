. * 6.2. Baseline 6a with no roads 6d
. local plot_list rent_du rent_duhe rent_mfdu rent_mf rent_mfhe rent_he

. local suffix "coef_rent_base_unweighted_noroads"

. local l1_title "Log Monthly Rent"

. local b1_title "<- More restrictive  |  Less restrictive ->"

. local b2_title "Distance to Boundary (miles)"

. 
. foreach r in `plot_list'{
  2.         
.         local pos = ustrpos("`r'", "_") + 1
  3.         local str = substr("`r'", `pos', .)
  4. 
.         if "`str'" == "du" {
  5.                 local title "Only DUPAC Changes"
  6.         }
  7.         
.         if "`str'" == "duhe" {
  8.                 local title "DUPAC and Height Change"
  9.         }
 10. 
.         if "`str'" == "mfdu" {
 11.                 local title "MF Allowed and DUPAC Change"
 12.         }
 13.         
.         if "`str'" == "mf" {
 14.                 local title "Only MF Allowed Changes"
 15.         }
 16.         
.         if "`str'" == "mfhe" {
 17.                 local title "MF Allowed and Height Change"
 18.         }
 19.         
.         if "`str'" == "he" {
 20.                 local title "Only Height Changes"
 21.         }
 22.         
.         * coefplots
.         #delimit;
delimiter now ;
.         coefplot 
>                 /* relaxed side graphing variables */
