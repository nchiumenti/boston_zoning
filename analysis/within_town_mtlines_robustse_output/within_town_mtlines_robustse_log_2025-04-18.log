. ********************************************************************************
. ** Part 7: SUPPLY EFFECT HIGH DENSITY BASELINE
. * 7a: high density baseline after 1918 @ .20 miles
. * 7b: high density baseline after 1956 @ .20 miles
. * 7c: high density baseline after 1918 @ .20 miles w/ only clear boundaries
. ********************************************************************************
. ** 7a: high density baseline after 1918 @ .20 miles
. * loop over different degrees of distance polynomial trends
. forvalues i = 1/3{
  2. 
.         * A: only_mf
.         quietly reg fam4plus_1 i.mf_allowed i.lam_seg `distance_varlist`i'' ///
>                 if only_mf == 1 & dist <= 0.2 & year_built >= 1918 & year == 2018, vce(robust) 
  3.                 
.                 eststo A
  4.                 
.         sum fam4plus_1 if only_mf == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
  5.         sum fam4plus_1 if only_mf == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                   
  6. 
.         * B: only_he
.         quietly reg fam4plus_1 height i.lam_seg `distance_varlist`i'' ///
>                 if only_he == 1 & dist <= 0.2 & year_built >= 1918 & year == 2018, vce(robust) 
  7. 
.                 eststo B        
  8.         
.         sum fam4plus_1 if only_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
  9.         sum fam4plus_1 if only_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"           
 10.         sum height if only_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 11.         sum height if only_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"               
 12. 
.         * C: only_du
.         quietly reg fam4plus_1 dupac i.lam_seg `distance_varlist`i'' ///
>                 if only_du == 1 & dist <= 0.2 & year_built >= 1918 & year == 2018, vce(robust)          
 13. 
.                 eststo C
 14.                 
.         sum fam4plus_1 if only_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 15.         sum fam4plus_1 if only_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                   
 16.         sum dupac if only_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 17.         sum dupac if only_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                        
 18. 
.         * D: mf_he
.         quietly reg fam4plus_1 i.mf_allowed##c.height i.lam_seg `distance_varlist`i'' ///
>                 if mf_he == 1 & dist <= 0.2 & year_built >= 1918 & year == 2018, vce(robust)                                    
 19. 
.                 eststo D
 20.                 
.                 * height
.                 test height 1.mf_allowed#c.height
 21.                 
.                 * mf_allowed
.                 test 1.mf_allowed 1.mf_allowed#c.height
 22.                 
.         sum fam4plus_1 if mf_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 23.         sum fam4plus_1 if mf_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                     
 24.         sum height if mf_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 25.         sum height if mf_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                 
 26. 
.         * E: mf_du
.         quietly reg fam4plus_1 i.mf_allowed##c.dupac i.lam_seg `distance_varlist`i'' ///
>                 if mf_du == 1 & dist <= 0.2 & year_built >= 1918 & year == 2018, vce(robust)
 27.                 
.                 eststo E
 28.                 
.         sum fam4plus_1 if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 29.         sum fam4plus_1 if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                     
 30.         sum dupac if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 31.         sum dupac if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                  
 32. 
.         * F: mf du, relaxed 2
.         quietly reg fam4plus_1 i.mf_allowed##c.dupac i.lam_seg `distance_varlist`i'' ///
>                 if mf_du == 1 & dist <= 0.2 & year_built >= 1918 & year == 2018, vce(robust)
 33. 
.                 eststo F
 34. 
.                 * dupac
.                 test dupac 1.mf_allowed#c.dupac
 35.                 
.                 * mf_allowed
.                 test 1.mf_allowed 1.mf_allowed#c.dupac
 36.                 
.         sum fam4plus_1 if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 37.         sum fam4plus_1 if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                     
 38.         sum dupac if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 39.         sum dupac if mf_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                  
 40. 
.         * G: du_he
.         quietly reg fam4plus_1 c.height##c.dupac i.lam_seg `distance_varlist`i'' ///
>                 if du_he == 1 & dist <= 0.2 & year_built >= 1918 & year == 2018, vce(robust)
 41. 
.                 eststo G
 42. 
.                 * dupac 
.                 test dupac c.height#c.dupac
 43.                 
.                 * height
.                 test height c.height#c.dupac
 44.                 
.         sum fam4plus_1 if du_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 45.         sum fam4plus_1 if du_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                     
 46.         sum dupac if du_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 47.         sum dupac if du_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                  
 48.         sum height if du_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 49.         sum height if du_he == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                 
 50. 
.         * H: all (mf du he)
.         quietly reg fam4plus_1 i.mf_allowed##c.height##c.dupac i.lam_seg `distance_varlist`i'' ///
>                 if mf_he_du == 1 & dist <= 0.2 & year_built >= 1918 & year == 2018, vce(robust) 
 51.                 
.                 eststo H
 52.                 
.                 test 1.mf_allowed height dupac
 53.                 test 1.mf_allowed height 
 54.                 test 1.mf_allowed dupac
 55.                 test height dupac       
 56.                 
.                 * dupac
.                 test dupac c.height#c.dupac 1.mf_allowed#c.dupac 1.mf_allowed#c.height#c.dupac
 57. 
.                 * height
.                 test height c.height#c.dupac 1.mf_allowed#c.height 1.mf_allowed#c.height#c.dupac
 58.                 
.                 * mf allowed
.                 test 1.mf_allowed 1.mf_allowed#c.dupac 1.mf_allowed#c.height 1.mf_allowed#c.height#c.dupac
 59.                 
.         sum fam4plus_1 if mf_he_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0.02 & dist_both>0) & res_typex!="Condominiums"
 60.         sum fam4plus_1 if mf_he_du == 1 & year==2018 & year_built>=1918 & (dist_both<=0 & dist_both>-0.02) & res_typex!="Condominiums"                  
 61. 
.         * combine results
.         esttab A B C D E F G H, se r2 nobase indicate("Boundary f.e.=*lam_seg") ///
>                 label mtitles("only_mf" "only_he" "only_du" "mf_he" "mf_du" "du_he" "All") ///
>                 title("Part 7a: high density baseline after 1918 @ .20 miles (distance polynomial trends degree `i')") 
 62.                 
.         eststo clear
 63. }

