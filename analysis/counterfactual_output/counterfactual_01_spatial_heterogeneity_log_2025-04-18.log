. ********************************************************************************
. ** Regression 1: linear probability rents and prices
. *** Part 1: loop over bandwidths for means
. *** Part 2(a-c): loop over bandwidth x polynomials for rents
. *** Part 3(a-c): loop over bandwith x polynomials for sales prices
. ********************************************************************************
. levelsof county, local(levels) 
`"Developing Suburbs"' `"Inner Core"' `"Mature Suburbs"'

. 
. * for every county <l> in <levels>
. foreach l of local levels {
  2. 
.         di ""
  3.         di ""
  4.         di "*** `l' ***"
  5. 
.         tab county if county == "`l'"
  6.         
. 
.         ********************************************************************************        
.         ** Part 1: loop over bandwidths for means
.         /* restricted to just the 0.02 and 0.2 bandwith in the final analysis because
>         that is what we end up showing, older versions use more */
.         ********************************************************************************
.         foreach d of numlist 0.02 0.2 {
  7.                 
.                 di ""
  8.                 di "*** bandwidth `d' ***"
  9.                 di "********************************************************************************"
 10.                 di "** means for `l' at bandwidth `d'"
 11.                 di "********************************************************************************"
 12.                 
.                 * only_du
.                 di "means for `l' at bandwidth `d': ONLY_DU, RELAXED SIDE ONLY"
 13.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac if county == "`l'" & only_du == 1 & dist_both<=`d' & dist_both>=0
 14.                 
.                 di "means for `l' at bandwidth `d': ONLY_DU, STRICT SIDE ONLY"
 15.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac  if county == "`l'" & only_du == 1 & dist_both>=-`d' & dist_both<0
 16.                 
.                 di "means for `l' at bandwidth `d': ONLY_DU, BOTH SIDES"
 17.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac  if county == "`l'" & only_du == 1 & dist<=`d'
 18. 
.                 * du_he
.                 di "means for `l' at bandwidth `d': DU_HE, RELAXED SIDE ONLY"
 19.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac height if county == "`l'" & du_he == 1 & dist_both<=`d' & dist_both>=0
 20.                 
.                 di "means for `l' at bandwidth `d': DU_HE, STRICT SIDE ONLY"
 21.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac height if county == "`l'" & du_he == 1 & dist_both>=-`d' & dist_both<0
 22.                 
.                 di "means for `l' at bandwidth `d': DU_HE, BOTH SIDES"
 23.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac height if county == "`l'" & du_he == 1 & dist<=`d'
 24.                 
.                 * mf_du
.                 di "means for `l' at bandwidth `d': MF_DU, RELAXED SIDE ONLY"
 25.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac mf_allowed if county == "`l'" & mf_du == 1 & dist_both<=`d' & dist_both>=0
 26.                 
.                 di "means for `l' at bandwidth `d': MF_DU, STRICT SIDE ONLY"
 27.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac mf_allowed if county == "`l'" & mf_du == 1 & dist_both>=-`d' & dist_both<0
 28.                 
.                 di "means for `l' at bandwidth `d': MF_DU, BOTH SIDES" 
 29.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac mf_allowed if county == "`l'" & mf_du == 1 & dist<=`d'
 30. 
.                 * only_mf
.                 di "means for `l' at bandwidth `d': ONLY_MF, RELAXED SIDE ONLY"
 31.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac if county == "`l'" & only_mf == 1 & dist_both<=`d' & dist_both>=0
 32.                 
.                 di "means for `l' at bandwidth `d': ONLY_MF, STRICT SIDE ONLY"
 33.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac  if county == "`l'" & only_mf == 1 & dist_both>=-`d' & dist_both<0
 34.                 
.                 di "means for `l' at bandwidth `d': ONLY_MF, BOTH SIDES"
 35.                 sum log_mfrent comb_rent2 house_rent log_saleprice theta_hd theta_gd dupac  if county == "`l'" & only_mf == 1 & dist<=`d'
 36.         
.         }  // end of part 1 loop
 37. 
. 
.         ********************************************************************************        
.         ** Part 2: renter costs with only_du du_he mf_du only_mf (run quietly)
.         ********************************************************************************        
.         di ""
 38.         di "*** log_mfrent regressions ***"
 39. 
.         * for every <d> bandwidth
.         quietly foreach d of numlist 0.02 0.2 {
 40.                 
.                 * set local var name for bandwith
.                 local var = round(`d' * 100, 1)
 41.                 
.                 ********************************************************************************        
.                 ** Part 2a: only_du
.                 ********************************************************************************
.                 * loop over different polynomial distance trends
.                 forvalues i = 1(2)3 {
 42.                         n di ""
 43.                         n di "********************************************************************************"
 44.                         n di "** Running regressions for log_mfrent only_du..."
 45.                         n di "** in `l'"
 46.                         n di "** at bandwidth `d'"
 47.                         n di "** with polynomial ^`i'"
 48.                         n di "********************************************************************************"
 49. 
.                         * set regression conditions 
.                         local regression_conditions only_du == 1 & dist <= `d' & res_typex != "Condominiums" & county == "`l'" & (year >= 2010 & year <= 2018)
 50.                         
.                         * tests if if there are observations run the regression
