. ********************************************************************************
. ** Regression 2: units spatial heterogeneity
. * Part 4: loop over bandwidths for means >=1918
. * Part 5(a-c): loop over bandwidth x polynomials for units >=1918
. * Part 6: loop over bandwidths for means >=1956
. * Part 7(a-c): loop over bandwith x polynomials for units >=1956
. ********************************************************************************
. levelsof county, local(levels) 
`"Developing Suburbs"' `"Inner Core"' `"Mature Suburbs"'

. 
. * for every county <l> in <levels>
. foreach l of local levels {
  2.         
.         di ""
  3.         di "*** `l' ***"
  4. 
.         tab county if county == "`l'"
  5.         
.         ********************************************************************************
.         ** Part 4: units built after 1918 with dupac, height, mf allowed 
.         /* restricted to just the 0.2 bandwith in the final analysis because that is 
>         what we end up showing, older versions use more */
.         ********************************************************************************
.         foreach d of numlist 0.02 0.2 {
  6.                 
.                 di ""
  7.                 di "*** bandwidth `d' ***"
  8.                 di "********************************************************************************"
  9.                 di "** means for `l' at bandwidth `d' >=1918"
 10.                 di "********************************************************************************"
 11. 
.                 * only_du
.                 di "means for `l': ONLY_DU, RELAXED SIDE ONLY, year_built >= 1918"
 12.                 sum num_units1  if county == "`l'" & only_du == 1 & year_built >= 1918 & (dist_both <= `d' & dist_both >= 0)
 13.                 
.                 di "means for `l': ONLY_DU, STRICT SIDE ONLY, year_built >= 1918"
 14.                 sum num_units1  if county == "`l'" & only_du == 1 & year_built >= 1918 & (dist_both >= -`d' & dist_both < 0)
 15.                 
.                 di "means for `l': ONLY_DU, BOTH SIDES, year_built >= 1918"
 16.                 sum num_units1  if county == "`l'" & only_du == 1 & year_built >= 1918 & dist <= `d'    
 17. 
.                 * du_he
.                 di "means for `l': DU_HE, RELAXED SIDE ONLY, year_built >= 1918"
 18.                 sum num_units1 if county == "`l'" & du_he == 1 & year_built >= 1918 & (dist_both <= `d' & dist_both >= 0)
 19.                 
.                 di "means for `l': DU_HE, STRICT SIDE ONLY, year_built >= 1918"
 20.                 sum num_units1 if county == "`l'" & du_he == 1 & year_built >= 1918 & (dist_both >= -`d' & dist_both < 0)
 21.                 
.                 di "means for `l': DU_HE, BOTH SIDES, year_built >= 1918"       
 22.                 sum num_units1 if county == "`l'" & du_he == 1 & year_built >= 1918 & dist <= 0.2       
 23.                 
.                 * mf_du
.                 di "means for `l': MF_DU, RELAXED SIDE ONLY, year_built >= 1918"
 24.                 sum num_units1 if county == "`l'" & mf_du == 1 & year_built >= 1918 & (dist_both <= `d' & dist_both >= 0)
 25.                 
.                 di "means for `l': MF_DU, STRICT SIDE ONLY, year_built >= 1918"
 26.                 sum num_units1 if county == "`l'" & mf_du == 1 & year_built >= 1918 & (dist_both >= -`d' & dist_both < 0)
 27.                 
.                 di "means for `l': MF_DU, BOTH SIDES, year_built >= 1918" 
 28.                 sum num_units1 if county == "`l'" & mf_du == 1 & year_built >= 1918 & dist <= `d'       
 29. 
.                 * only_mf
.                 di "means for `l': ONLY_MF, RELAXED SIDE ONLY, year_built >= 1918"
 30.                 sum num_units1  if county == "`l'" & only_mf == 1 & year_built >= 1918 & (dist_both <= `d' & dist_both >= 0)
 31.                 
.                 di "means for `l': ONLY_MF, STRICT SIDE ONLY, year_built >= 1918"
 32.                 sum num_units1  if county == "`l'" & only_mf == 1 & year_built >= 1918 & (dist_both >= -`d' & dist_both < 0)
 33.                 
.                 di "means for `l': ONLY_MF, BOTH SIDES, year_built >= 1918"
 34.                 sum num_units1  if county == "`l'" & only_mf == 1 & year_built >= 1918 & dist <= `d'
 35.         }  // end of part 4 bandwith loop
