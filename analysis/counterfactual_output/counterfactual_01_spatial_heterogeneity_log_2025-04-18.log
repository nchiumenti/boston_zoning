.                 forvalues i = 1(2)3 {
139.                         n di ""
140.                         n di "********************************************************************************"
141.                         n di "** Running regressions for num_units1 only_mf >=1918..."
142.                         n di "** in `l'"
143.                         n di "** at bandwidth `d'"
144.                         n di "** with polynomial ^`i'"
145.                         n di "********************************************************************************"
146. 
.                         * set regression conditions
.                         local regression_conditions only_mf == 1 & dist <= `d' & year_built >= 1918 & county == "`l'" & (year == 2018)
147.         
.                         * tests if there are observations, if yes run regression
.                         count if num_units1 != . & `regression_conditions'
148.                         local a = r(N)
149.                                 
.                         if `a'>1 {
150.                                 
.                                 * run regression
.                                 capture noisily reg num_units1 i.mf_allowed i.lam_seg `distance_varlist`i'' if `regression_conditions', vce(cluster lam_seg)                                                    
151.                                 * display observation count 
.                                 n di "# of obs. for `l' at bandwith `d' with polynomial ^`i' for reg num_units1 only_mf >=1918 == `e(N)'"
152.                         
.                                 * if no error, store coefficients and standard errors
.                                 if c(rc) == 0 {
153.                                         replace mf_coeff_u18_c_`var'_x`i' = _b[1.mf_allowed] if county == "`l'"
154.                                         replace mf_se_u18_c_`var'_x`i' = _se[1.mf_allowed] if county == "`l'"   
155.                                 }
156.                         
.                                 * else if error 2001, raise insufficient results error
.                                 else if c(rc) == 2001 {
157.                                         n di as error "Insufficient results for reg num_units1 only_mf, l==`l', d==`d', ^i==`i': moving on..."
158.                                 }
159. 
.                                 * else, catch all other errors
.                                 else {
160.                                         local rc = _rc                  
161.                                         n di as error "reg num_units1 only_mf, l==`l', d==`d', ^i==`i' caused error r(`rc')"
162.                                 }
163.                         }
164.                                 
.                         * else, not enough obs to run regression
.                         else {
165.                                 n di as error `"not enough observations to run `regression_conditions'"'
166.                         }
167.                 }  // end of part 5d polynomial loop
168.         }  // end of part 5 bandwidth loop
169. }  // end of levelsof county/community type loop

